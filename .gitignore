# Internal tooling and generated caches
*.py
scripts/*.py
*.sh
# Public conversion entry points and their complete implementation.
!/convert_all_urdf_to_mjcf.sh
!/convert_all_urdf_to_usd.sh
!/urdf_to_mjcf.py
!/convert_urdf_v4.py
!/convert_urdf_new.py
!/revo3_collision_v4.py
!/revo3_collision_optimized.py
!/revo3_system/tools/sync_optimized_collisions.py
!/revo3_system/tools/verify_optimized_urdf.py
__pycache__/
*.py[cod]

# Customers generate simulation formats locally from the published URDFs.
/*_system/mjcf/
/*_system/usd/

# Internal or non-public model sets
flexiv_system/
**/*_none.urdf
**/*_none.xml
**/*_none.usd
**/*_none_base.usd
**/*_none_physics.usd
**/*_none_robot.usd
**/*_none_sensor.usd
**/*.asset_hash
**/*config.yaml
# Local workspace/editor state
.agents/
.codex/
.vscode/
.idea/

# OS metadata
.DS_Store
Thumbs.db

# Previews of model sets excluded from the public repository
visualizations/flexiv_system/
visualizations/**/*_none.png
